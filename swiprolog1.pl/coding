% Facts: parent(Parent, Child)

parent(john, david).
parent(mary, david).

parent(john, lisa).
parent(mary, lisa).

parent(david, tom).
parent(sarah, tom).

parent(david, anna).
parent(sarah, anna).

% Gender facts
female(mary).
female(sarah).
female(lisa).
female(anna).

male(john).
male(david).
male(tom).

% Mother relation
mother(X, Y) :-
    parent(X, Y),
    female(X).

% Father relation
father(X, Y) :-
    parent(X, Y),
    male(X).

% Grandfather relation
grandfather(X, Y) :-
    parent(X, Z),
    father(Z, Y).

% Grandmother relation
grandmother(X, Y) :-
    parent(X, Z),
    mother(Z, Y).

% Sister relation
sister(X, Y) :-
    parent(Z, X),
    parent(Z, Y),
    female(X),
    X \= Y.

% Brother relation
brother(X, Y) :-
    parent(Z, X),
    parent(Z, Y),
    male(X),
    X \= Y.
