
def is_safe(node, graph, colors, color):
    for neighbor in graph[node]:
        if colors[neighbor] == color:
            return False
    return True


def map_coloring(graph, m, colors, node=0):
    if node == len(graph):
        return True

    for color in range(1, m + 1):
        if is_safe(node, graph, colors, color):
            colors[node] = color

            if map_coloring(graph, m, colors, node + 1):
                return True

            colors[node] = 0

    return False


graph = {
    0: [1, 2],
    1: [0, 2, 3],
    2: [0, 1, 3],
    3: [1, 2]
}

color_names = {
    1: "Red",
    2: "Green",
    3: "Blue"
}

m = 3
colors = [0] * len(graph)

if map_coloring(graph, m, colors):
    print("Map Coloring Solution:")
    for node in range(len(graph)):
        print("Region", node, ":", color_names[colors[node]])
else:
    print("No solution exists")
